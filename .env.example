# 云服务器 .env 模板：cp .env.example .env，然后填入真实 key
# 注意：DB_URI / REDIS_URL 指向 docker 网络内的服务名（postgres / redis），端口用容器内部端口 5432 / 6379

# ---- Postgres / Redis（docker 网络内）----
# POSTGRES_PASSWORD 需与 docker-compose.prod.yml 里 ${POSTGRES_PASSWORD:-123456} 一致
POSTGRES_PASSWORD=123456
DB_URI=postgresql://gq210:123456@postgres:5432/postgres?sslmode=disable
REDIS_URL=redis://redis:6379/0

# ---- 高德地图 MCP ----
AMAP_MAPS_API_KEY=your_amap_key

# ---- LLM 回退链：qwen -> deepseek -> openai（至少配一个）----
QWEN_API_KEY=your_qwen_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LAOZHANG_API_KEY=your_openai_key
LAOZHANG_BASE_URL=https://api.laozhang.ai/v1

# ---- 攻略/游记搜索（可选，缺省则诚实降级）----
TAVILY_API_KEY=your_tavily_key

# ---- 中文 embedding（768 维，需与 pgvector 列对齐）----
# 云端用 EMBEDDING_PROVIDER=qwen 走通义 API（免装 torch）；本地默认 local（bge）不用配这个
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v4
# 本地若复用已下载的 bge 模型可设置，云端不生效：
# BGE_MODEL_PATH=C:\Users\qian gao\models\BAAI\bge-base-zh-v1___5

# ---- 运行参数 ----
LOG_LEVEL=INFO
LLM_TIMEOUT=120
